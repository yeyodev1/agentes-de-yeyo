# Solo para correr en tu Mac. En GitHub van como secrets (S) o variables (V).

# Claude: usa UNO de los dos
CLAUDE_CODE_OAUTH_TOKEN=     # (S) sale de `claude setup-token` (usa tu plan Pro/Max)
# ANTHROPIC_API_KEY=         # (S)

# Cloudflare: memoria compartida en D1
CF_API_TOKEN=                # (S) token con Workers Scripts:Edit y D1:Edit
CF_ACCOUNT_ID=9f8ec1f811c0bbb8177ca20665b2f72b   # (V)
CF_D1_ID=                    # (V) sale de `wrangler d1 create cerebro-yeyo`

# Telegram
TELEGRAM_BOT_TOKEN=          # (S) de @BotFather
# TELEGRAM_CHAT_ID lo guarda el Worker en D1 al vincular el bot (link con TELEGRAM_VINCULO)

# LinkedIn (developer.linkedin.com → tu app → Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=       # (S) los llena `npm run token:linkedin`
LINKEDIN_PERSON_ID=          # (S)
LINKEDIN_TOKEN_EXPIRA=       # (S)

# X (developer.x.com → tu app → Keys and tokens → OAuth 2.0)
X_CLIENT_ID=                 # (S)
X_CLIENT_SECRET=             # (S)
# El refresh token NO va aquí: `npm run token:x` lo guarda en D1.

# Resend (correos desde yeyo.dev)
RESEND_API_KEY=
